---
/**
 * BaseLayout.astro — HTML shell for all pages.
 *
 * Props:
 *   title       — Page <title> (required)
 *   description — Meta description (required)
 *   locale      — 'es' | 'en' (required)
 *   canonical   — Canonical URL for this page
 *   alternates  — { es: string; en: string } — hreflang alternate URLs
 *   ogImage     — Optional OG image URL (default: /og-default.png)
 */
import type { Locale } from '../i18n/index';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonical: string;
  alternates: { es: string; en: string };
  ogImage?: string;
}

const {
  title,
  description,
  locale,
  canonical,
  alternates,
  ogImage = '/og-default.png',
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <!-- SEO: title, description, canonical, hreflang, og, twitter -->
    <SEO
      title={title}
      description={description}
      locale={locale}
      canonical={canonical}
      alternates={alternates}
      ogImage={ogImage}
    />

    <!-- Favicon: use the square brand mark (recognizable at 16×16, no text) -->
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />

    <!-- Font preload: Inter (primary UI font) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href="/fonts/inter/inter-latin-wght-normal.woff2"
    />

    <!-- Structured data: Person + WebSite -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://jnvr-portafolio.web.app/#person",
            "name": "Jonathan Noé Viramontes",
            "url": "https://jnvr-portafolio.web.app",
            "jobTitle": "Full-Stack Developer",
            "sameAs": [
              "https://github.com/jnvr1",
              "https://linkedin.com/in/jnvr"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://jnvr-portafolio.web.app/#website",
            "url": "https://jnvr-portafolio.web.app",
            "name": "JNVR — Desarrollador Full-Stack",
            "author": { "@id": "https://jnvr-portafolio.web.app/#person" }
          }
        ]
      }
    </script>

    <!-- Styles -->
    <style is:global>
      @import '../styles/tokens.css';
      @import '../styles/reset.css';
      @import '../styles/fonts.css';
      @import '../styles/global.css';
    </style>

    <!-- Named slot for page-specific head tags -->
    <slot name="head" />
  </head>

  <body>
    <!-- Skip to content link (a11y) -->
    <a class="skip-link" href="#main-content">
      {locale === 'es' ? 'Ir al contenido principal' : 'Skip to main content'}
    </a>

    <!-- Content wrapper: z-index 1 places all page content above the
         atmospheric orbs (body::before/::after at z-index 0) while
         the SVG faceted backdrop stays as the body's background layer. -->
    <div class="page-content">
      <slot />
    </div>

    <!-- No-op Service Worker registration (evicts Angular SW) -->
    <script>
      import '../scripts/noop-sw-register.ts';
    </script>
  </body>
</html>

<style>
  /* Elevates all page content above the atmospheric orb pseudo-elements */
  .page-content {
    position: relative;
    z-index: 1;
  }

  .skip-link {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    background: var(--accent);
    color: var(--bg);
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    z-index: 9999;
    border-radius: 0 0 4px 0;
    text-decoration: none;
  }

  .skip-link:focus {
    position: fixed;
    left: 0;
    top: 0;
    width: auto;
    height: auto;
    overflow: visible;
  }
</style>
