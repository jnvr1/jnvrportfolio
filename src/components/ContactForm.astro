---
/**
 * ContactForm.astro — EmailJS-backed contact form.
 *
 * Design decisions:
 * - NO emailjs-com npm package — uses raw fetch() to POST to EmailJS REST API
 * - Keys are PUBLIC (client-safe) — stored in src/config/contact.ts
 * - Full a11y: visible labels, aria-invalid, aria-describedby, role="status" live region
 * - Honeypot field for basic bot protection
 * - client:load so the form is interactive immediately
 *
 * Props:
 *   locale — 'es' | 'en'
 */
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import ScrollReveal from './ScrollReveal.astro';
import SectionBackdrop from './SectionBackdrop.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const formId = 'contact-form';
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <SectionBackdrop variant="contact" />
  <div class="contact-inner">
    <ScrollReveal>
      <h2 id="contact-heading">{t(locale, 'contact.title')}</h2>
      <p class="contact-subtitle">{t(locale, 'contact.subtitle')}</p>
    </ScrollReveal>

    <ScrollReveal delay={100}>
      <form
        id={formId}
        class="contact-form"
        novalidate
        data-locale={locale}
      >
        <!-- Honeypot (hidden from real users, bots fill it in) -->
        <input
          type="text"
          name="honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="contact-form__honeypot"
        />

        <!-- Name -->
        <div class="form-field">
          <label for="contact-name" class="form-label">
            {t(locale, 'form.name')}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            class="form-input"
            placeholder={t(locale, 'form.namePlaceholder')}
            autocomplete="name"
            aria-required="true"
            aria-invalid="false"
            aria-describedby="contact-name-error"
          />
          <span
            id="contact-name-error"
            class="form-error"
            data-error="name"
            role="alert"
            aria-live="polite"
          ></span>
        </div>

        <!-- Email -->
        <div class="form-field">
          <label for="contact-email" class="form-label">
            {t(locale, 'form.email')}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            class="form-input"
            placeholder={t(locale, 'form.emailPlaceholder')}
            autocomplete="email"
            aria-required="true"
            aria-invalid="false"
            aria-describedby="contact-email-error"
          />
          <span
            id="contact-email-error"
            class="form-error"
            data-error="email"
            role="alert"
            aria-live="polite"
          ></span>
        </div>

        <!-- Message -->
        <div class="form-field">
          <label for="contact-message" class="form-label">
            {t(locale, 'form.message')}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            class="form-input form-textarea"
            placeholder={t(locale, 'form.messagePlaceholder')}
            rows="5"
            aria-required="true"
            aria-invalid="false"
            aria-describedby="contact-message-error"
          ></textarea>
          <span
            id="contact-message-error"
            class="form-error"
            data-error="message"
            role="alert"
            aria-live="polite"
          ></span>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="btn btn-primary form-submit"
          id="contact-submit"
        >
          {t(locale, 'form.submit')}
        </button>

        <!-- Status message (success / error) -->
        <div
          id="contact-status"
          class="form-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          tabindex="-1"
        ></div>
      </form>
    </ScrollReveal>
  </div>
</section>

<style>
  .contact-section {
    padding: var(--space-16) var(--space-4);
    /* Position context for SectionBackdrop (position: absolute, inset: 0) */
    position: relative;
    overflow: hidden;
  }

  .contact-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    /* Elevate above SectionBackdrop */
    position: relative;
    z-index: 1;
  }

  .contact-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .contact-subtitle {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-form__honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .form-required {
    color: var(--danger);
  }

  .form-input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: var(--space-3) var(--space-3);
    transition: border-color 150ms, box-shadow 150ms;
    width: 100%;
    box-sizing: border-box;
    min-height: 44px;
    touch-action: manipulation;
  }

  .form-input::placeholder {
    color: var(--muted);
    opacity: 0.6;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .form-input[aria-invalid='true'] {
    border-color: var(--danger);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 15%, transparent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-error {
    font-size: 0.8125rem;
    color: var(--danger);
    min-height: 1.25em;
  }

  .form-submit {
    align-self: flex-start;
    min-width: 160px;
    min-height: 44px;
  }

  .form-submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: not-allowed;
    pointer-events: none;
  }

  .form-status {
    font-size: 0.9375rem;
    padding: var(--space-3);
    border-radius: 6px;
    min-height: 2em;
    transition: opacity 200ms;
  }

  .form-status:empty {
    padding: 0;
  }

  .form-status--success {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .form-status--error {
    background: color-mix(in srgb, var(--danger) 10%, transparent);
    color: var(--danger);
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
  }

  @media (max-width: 480px) {
    .contact-section {
      padding: var(--space-12) var(--space-4);
    }

    .form-submit {
      width: 100%;
      align-self: stretch;
    }
  }
</style>

<script>
  import { submitContactForm, validateContactForm } from '../scripts/contact-form';
  import { t } from '../i18n/index';
  import type { Locale } from '../i18n/index';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('contact-status') as HTMLElement | null;

  if (!form || !submitBtn || !statusEl) {
    // Form not present on this page
  } else {
    const locale = (form.dataset.locale ?? 'es') as Locale;

    function setFieldError(field: string, messageKey: string | undefined) {
      const input = form!.querySelector<HTMLElement>(`[name="${field}"]`);
      const errorEl = form!.querySelector<HTMLElement>(`[data-error="${field}"]`);
      if (input) {
        input.setAttribute('aria-invalid', messageKey ? 'true' : 'false');
      }
      if (errorEl) {
        errorEl.textContent = messageKey ? t(locale, `form.${messageKey}`) : '';
      }
    }

    function clearAllErrors() {
      ['name', 'email', 'message'].forEach((field) => setFieldError(field, undefined));
    }

    function setStatus(message: string, type: 'success' | 'error' | '') {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.className = `form-status${type ? ` form-status--${type}` : ''}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();
      setStatus('', '');

      const data = new FormData(form);
      // Honeypot check
      if (data.get('honeypot')) return;

      const name = String(data.get('name') ?? '');
      const email = String(data.get('email') ?? '');
      const message = String(data.get('message') ?? '');
      const time = new Date().toLocaleString(locale === 'es' ? 'es-MX' : 'en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
      });

      // Client-side validation
      const errors = validateContactForm({ name, email, message });
      if (Object.keys(errors).length > 0) {
        for (const [field, errorKey] of Object.entries(errors)) {
          setFieldError(field, errorKey);
        }
        // Focus the first invalid field
        const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        firstInvalid?.focus();
        return;
      }

      // Submit
      submitBtn!.setAttribute('aria-busy', 'true');
      submitBtn!.textContent = t(locale, 'form.submitting');

      const result = await submitContactForm({
        name,
        from_name: name,
        email,
        reply_to: email,
        time,
        subject: `Portfolio contact from ${name}`,
        message,
      });

      submitBtn!.removeAttribute('aria-busy');
      submitBtn!.textContent = t(locale, 'form.submit');

      if (result.ok) {
        setStatus(t(locale, 'form.success'), 'success');
        form.reset();
        statusEl!.focus();
      } else {
        setStatus(t(locale, 'form.error'), 'error');
        statusEl!.focus();
      }
    });
  }
</script>
