---
/**
 * ExperienceCard.astro — Single experience entry as a translucent layered panel.
 *
 * Each card is a glass-morphism panel with faceted clip-path corners, positioned
 * in the shared stacking grid cell via nth-child transforms in global.css.
 *
 * Featured card (Fletes, index 0): top of the stack, full content visible,
 * brand top-edge accent, subtle glow. Past cards: slightly offset, body
 * truncated to 3 lines until hover/focus reveals full content.
 *
 * Props:
 *   entry      — CollectionEntry<'experience'>
 *   locale     — 'es' | 'en'
 *   index      — position in sorted array (0 = featured)
 *   isFeatured — boolean, true for the current/featured role
 *   yearLabel  — pre-computed year string ("2023–pres", "2021–2023", "2021")
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';

interface Props {
  entry: CollectionEntry<'experience'>;
  locale: Locale;
  index: number;
  isFeatured: boolean;
  yearLabel: string;
}

const { entry, locale, index, isFeatured, yearLabel } = Astro.props;
const { company, role, startYear, endYear, current, location, summary, highlights, stack } =
  entry.data;

const currentRoleLabel = t(locale, 'experience.currentRole');
const dateRange = `${startYear}/${endYear ?? 'present'}`;
---

<article
  class:list={['xp-card', { 'xp-card--featured': isFeatured }]}
  data-index={index}
  data-featured={isFeatured ? 'true' : 'false'}
  aria-current={isFeatured ? 'true' : undefined}
  tabindex="0"
>
  {/* Year range — mono, top of card */}
  <span class="xp-card__year" aria-hidden="true">{yearLabel}</span>

  <header class="xp-card__header">
    <h3 class="xp-card__role">{role}</h3>
    <div class="xp-card__company-row">
      <span class="xp-card__company">{company}</span>
      {location && (
        <span class="xp-card__location" aria-label={`Location: ${location}`}>
          {location}
        </span>
      )}
    </div>
    {current && (
      <span class="xp-card__badge">{currentRoleLabel}</span>
    )}
    <time
      class="xp-card__period sr-only"
      datetime={dateRange}
      aria-label={`${yearLabel}`}
    >
      {yearLabel}
    </time>
  </header>

  <div class="xp-card__body">
    <p class="xp-card__summary">{summary}</p>

    {highlights && highlights.length > 0 && (
      <ul class="xp-card__highlights">
        {highlights.map((h: string) => (
          <li>{h}</li>
        ))}
      </ul>
    )}
  </div>

  {stack && stack.length > 0 && (
    <ul class="stack-chips" aria-label="Tech stack">
      {stack.map((tech: string) => (
        <li class="stack-chip">
          <svg viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
            <polygon points="4,0 8,4 4,8 0,4" fill="var(--brand)" opacity="0.6" />
          </svg>
          <span>{tech}</span>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  /* ── Card panel — glass morphism translucent paper ───────────────────────── */

  .xp-card {
    /* Translucent glass surface */
    background-color: rgba(15, 41, 63, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    /* Faceted edges echoing logo letter cuts */
    clip-path: polygon(
      0 0,
      calc(100% - 20px) 0,
      100% 20px,
      100% 100%,
      20px 100%,
      0 calc(100% - 20px)
    );

    /* Brand-tinted border */
    border: 1px solid rgba(115, 160, 190, 0.15);

    /* Generous internal spacing */
    padding: var(--space-6);

    /* Consistent height across the stack */
    min-height: clamp(280px, 30vh, 360px);

    /* Flex layout for content */
    display: flex;
    flex-direction: column;
    gap: var(--space-3);

    /* Focus ring on inner content, not the clipped outer — use outline-offset */
    outline: none;

    /* Transition for hover/focus lift */
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms var(--ease-standard),
      box-shadow 300ms var(--ease-standard);

    /* Cursor */
    cursor: default;
  }

  /* Focus ring drawn inside, not clipped by clip-path */
  .xp-card:focus-visible {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--brand),
      0 8px 32px rgba(115, 160, 190, 0.18);
  }

  /* ── Featured card: top of stack ─────────────────────────────────────────── */

  .xp-card--featured {
    border-top: 2px solid var(--brand);
    box-shadow: 0 8px 32px rgba(115, 160, 190, 0.18);
    /* Scale up slightly vs the base card transform */
  }

  /* ── Year range — mono, muted ────────────────────────────────────────────── */

  .xp-card__year {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-muted);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  /* ── Header ──────────────────────────────────────────────────────────────── */

  .xp-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex-shrink: 0;
  }

  .xp-card__role {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw + 0.5rem, 1.25rem);
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .xp-card__company-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .xp-card__company {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
  }

  .xp-card--featured .xp-card__company {
    color: var(--accent);
  }

  .xp-card__location {
    font-size: 0.8125rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .xp-card__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: var(--radius-full);
    padding: 3px var(--space-2);
  }

  .xp-card__period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ── Body — truncated for past roles, full for featured ──────────────────── */

  .xp-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .xp-card__summary {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    /* Past cards: truncate to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Featured: show full summary */
  .xp-card--featured .xp-card__summary {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  /* Hover/focus: reveal full summary on past cards too */
  .xp-card:hover .xp-card__summary,
  .xp-card:focus-within .xp-card__summary {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .xp-card__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* Past cards: hide highlights until hover/focus */
  }

  .xp-card:not(.xp-card--featured) .xp-card__highlights {
    display: none;
  }

  .xp-card:not(.xp-card--featured):hover .xp-card__highlights,
  .xp-card:not(.xp-card--featured):focus-within .xp-card__highlights {
    display: flex;
  }

  .xp-card__highlights li {
    font-size: 0.875rem;
    color: var(--muted);
    padding-left: var(--space-3);
    position: relative;
  }

  .xp-card__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.5;
  }

  /* ── Faceted diamond tech stack chips ────────────────────────────────────── */

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 0;
    flex-shrink: 0;
  }

  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stack-chip svg {
    flex-shrink: 0;
  }

  /* ── Screen-reader only utility ──────────────────────────────────────────── */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
