---
/**
 * ExperienceCard.astro — Single experience entry card body.
 *
 * Renders the card content only — the wrapping <li class="timeline-entry">
 * is handled by ExperienceList.astro which owns the timeline grid structure.
 *
 * Featured entries (Fletes México, featured:true) have visual emphasis:
 * stronger border, brand glow, and subtle scale.
 *
 * Props:
 *   entry  — CollectionEntry<'experience'>
 *   locale — 'es' | 'en'
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';

interface Props {
  entry: CollectionEntry<'experience'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { company, role, startYear, endYear, current, featured, location, summary, highlights, stack } =
  entry.data;

const endDisplay = current ? t(locale, 'experience.present') : String(endYear ?? '');
const dateRange = `${startYear}–${endDisplay}`;
const currentRoleLabel = t(locale, 'experience.currentRole');
---

<div class:list={['experience-card', { 'experience-card--featured': featured }]}>
  <div class="experience-card__body">
    <header class="experience-card__header">
      <div class="experience-card__company-row">
        <span class="experience-card__company">{company}</span>
        {location && (
          <span class="experience-card__location" aria-label={`Location: ${location}`}>
            {location}
          </span>
        )}
      </div>
      <p class="experience-card__role">{role}</p>
      {current && (
        <span class="experience-card__badge">
          {currentRoleLabel}
        </span>
      )}
      <time
        class="experience-card__period"
        datetime={`${startYear}/${endYear ?? 'present'}`}
        aria-label={`${startYear} to ${endDisplay}`}
      >
        {dateRange}
      </time>
    </header>

    <p class="experience-card__summary">{summary}</p>

    {highlights && highlights.length > 0 && (
      <ul class="experience-card__highlights">
        {highlights.map((h: string) => (
          <li>{h}</li>
        ))}
      </ul>
    )}

    {stack && stack.length > 0 && (
      <ul class="stack-chips" aria-label="Tech stack">
        {stack.map((tech: string) => (
          <li class="stack-chip">
            <svg viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
              <polygon points="4,0 8,4 4,8 0,4" fill="var(--brand)" opacity="0.6" />
            </svg>
            <span>{tech}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

<style>
  .experience-card {
    position: relative;
    list-style: none;
  }

  .experience-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 88%, var(--brand) 12%) 0%, var(--surface) 100%);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    clip-path: polygon(0 0, calc(100% - var(--clip-facet)) 0, 100% var(--clip-facet), 100% 100%, 0 100%);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      border-width var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      transform var(--card-hover-duration) var(--ease-standard);
  }

  .experience-card:hover .experience-card__body {
    border-color: var(--brand);
    border-width: var(--border-width-strong);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--brand) 12%, transparent);
    transform: var(--card-hover-transform);
  }

  /* Featured: brand border + glow */
  .experience-card--featured .experience-card__body {
    border-width: var(--border-width-strong);
    border-color: var(--brand);
    box-shadow: 0 0 24px rgba(115, 160, 190, 0.18);
    transform: scale(1.03);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 80%, var(--accent) 20%) 0%, var(--surface) 100%);
  }

  .experience-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .experience-card__company-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .experience-card__company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .experience-card--featured .experience-card__company {
    color: var(--accent);
  }

  .experience-card__location {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .experience-card__role {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    margin: 0;
    opacity: 0.85;
  }

  .experience-card__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 999px;
    padding: 3px var(--space-2);
  }

  .experience-card__period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .experience-card__summary {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  .experience-card__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .experience-card__highlights li {
    font-size: 0.875rem;
    color: var(--muted);
    padding-left: var(--space-3);
    position: relative;
  }

  .experience-card__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.5;
  }

  /* ── Faceted diamond tech stack chips ────────────────────────────────────── */

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 0;
  }

  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stack-chip svg {
    flex-shrink: 0;
  }
</style>
