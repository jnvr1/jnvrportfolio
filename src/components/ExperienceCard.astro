---
/**
 * ExperienceCard.astro — Single experience entry as an editorial band row.
 *
 * Renders the INNER CONTENT of an xp-band <li> (the <li> itself lives in
 * ExperienceList.astro and owns the band-level chrome: padding, divider, featured
 * top edge). This component is responsible for:
 *
 *   LEFT column  — large mono year anchor (tabular-nums, text-muted)
 *   RIGHT column — role title, company, location, summary, highlights, stack chips
 *
 * Featured band (isFeatured=true): brand top-edge + accent company color +
 * 3-polygon facet cluster SVG positioned top-right of the content area.
 *
 * All highlights are visible by default for ALL bands (no truncation, no hover gate).
 * Summary paragraph is never truncated.
 *
 * Props:
 *   entry      — CollectionEntry<'experience'>
 *   locale     — 'es' | 'en'
 *   index      — position in sorted array (0 = featured)
 *   isFeatured — boolean, true for the current/featured role
 *   yearLabel  — pre-computed year string ("2023–pres", "2021–2023", "2021")
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';

interface Props {
  entry: CollectionEntry<'experience'>;
  locale: Locale;
  index: number;
  isFeatured: boolean;
  yearLabel: string;
}

const { entry, locale, index, isFeatured, yearLabel } = Astro.props;
const { company, role, startYear, endYear, current, location, summary, highlights, stack } =
  entry.data;

const currentRoleLabel = t(locale, 'experience.currentRole');
const dateRange = `${startYear}/${endYear ?? 'present'}`;
---

<article
  class:list={['xp-band-content', { 'xp-band-content--featured': isFeatured }]}
  data-index={index}
  aria-current={isFeatured ? 'true' : undefined}
>
  {/* LEFT: year column */}
  <div class="xp-band__year-col" aria-hidden="true">
    <span class="xp-band__year">{yearLabel}</span>
  </div>

  {/* RIGHT: content column */}
  <div class="xp-band__content-col">
    {/* Featured facet cluster — positioned top-right of content area */}
    {isFeatured && (
      <svg
        class="featured-facets"
        viewBox="0 0 80 60"
        width="80"
        height="60"
        aria-hidden="true"
        focusable="false"
      >
        <polygon points="0,0 50,0 30,30 0,15" fill="var(--brand)" opacity="0.18" />
        <polygon points="50,0 80,15 60,40 30,30" fill="var(--brand)" opacity="0.12" />
        <polygon points="0,15 30,30 25,55 0,45" fill="var(--brand)" opacity="0.08" />
      </svg>
    )}

    <header class="xp-band__header">
      <div class="xp-band__company-row">
        <span class="xp-band__company">{company}</span>
        {location && (
          <span class="xp-band__location" aria-label={`Location: ${location}`}>
            {location}
          </span>
        )}
      </div>

      <h3 class="xp-band__role">{role}</h3>

      {current && (
        <span class="xp-band__badge">{currentRoleLabel}</span>
      )}

      {/* Hidden accessible time element — year is visually in the left column */}
      <time
        class="sr-only"
        datetime={dateRange}
        aria-label={yearLabel}
      >
        {yearLabel}
      </time>
    </header>

    <div class="xp-band__body">
      <p class="xp-band__summary">{summary}</p>

      {highlights && highlights.length > 0 && (
        <ul class="xp-band__highlights">
          {highlights.map((h: string) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
    </div>

    {stack && stack.length > 0 && (
      <ul class="stack-chips" aria-label="Tech stack">
        {stack.map((tech: string) => (
          <li class="stack-chip">
            <svg viewBox="0 0 8 8" width="8" height="8" aria-hidden="true">
              <polygon points="4,0 8,4 4,8 0,4" fill="var(--brand)" opacity="0.6" />
            </svg>
            <span>{tech}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  /* ── Band content: two-column grid ─────────────────────────────────────── */

  .xp-band-content {
    display: grid;
    grid-template-columns: clamp(7rem, 14vw, 11rem) 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  /* ── Year column ─────────────────────────────────────────────────────────── */

  .xp-band__year-col {
    display: flex;
    justify-content: flex-end;
    align-self: start;
    padding-top: 0.15em; /* optical alignment with company row */
  }

  .xp-band__year {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3rem);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  /* ── Content column ──────────────────────────────────────────────────────── */

  .xp-band__content-col {
    position: relative; /* anchor for facet cluster */
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ── Featured facet cluster ──────────────────────────────────────────────── */

  .featured-facets {
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: none;
    flex-shrink: 0;
  }

  /* ── Header ──────────────────────────────────────────────────────────────── */

  .xp-band__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* Make sure header doesn't overlap the facet cluster on wide viewports */
    padding-right: clamp(0px, 5vw, 96px);
  }

  .xp-band-content--featured .xp-band__header {
    padding-right: 92px; /* reserve space for the 80px facet cluster + gap */
  }

  .xp-band__company-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .xp-band__company {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* Featured: company name in accent warm-light-blue */
  .xp-band-content--featured .xp-band__company {
    color: var(--accent);
  }

  .xp-band__location {
    font-size: 0.8125rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .xp-band__role {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw + 0.5rem, 1.25rem);
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .xp-band__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: var(--radius-full);
    padding: 3px var(--space-2);
  }

  /* ── Body ────────────────────────────────────────────────────────────────── */

  .xp-band__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .xp-band__summary {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  .xp-band__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .xp-band__highlights li {
    font-size: 0.875rem;
    color: var(--muted);
    padding-left: var(--space-3);
    position: relative;
  }

  .xp-band__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.5;
  }

  /* ── Faceted diamond tech stack chips ────────────────────────────────────── */

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 0;
  }

  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stack-chip svg {
    flex-shrink: 0;
  }

  /* ── Screen-reader only utility ──────────────────────────────────────────── */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Mobile: single-column flow ──────────────────────────────────────────── */

  @media (max-width: 768px) {
    .xp-band-content {
      grid-template-columns: 1fr;
    }

    .xp-band__year-col {
      justify-content: flex-start;
      padding-top: 0;
    }

    .xp-band__year {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    .xp-band-content--featured .xp-band__header {
      padding-right: 0;
    }

    .xp-band__header {
      padding-right: 0;
    }

    .featured-facets {
      /* On mobile, move facet cluster to top-right of content column
         but reduce its visual dominance */
      opacity: 0.6;
      width: 56px;
      height: 42px;
    }
  }
</style>
