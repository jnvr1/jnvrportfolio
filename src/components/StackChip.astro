---
/**
 * StackChip.astro — Single technology badge.
 *
 * Uses JetBrains Mono, rendered as a non-interactive chip.
 *
 * Props:
 *   tech   — Technology name (e.g. "Flutter")
 *   locale — 'es' | 'en' (kept for caller API; visible mono text is read directly)
 */
import type { Locale } from "../i18n/index";

interface Props {
  tech: string;
  locale: Locale;
}

const { tech } = Astro.props;
---

<span class="stack-chip">
  {tech}
</span>

<style>
  .stack-chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    background: var(--surface-2);
    color: var(--accent);
    padding: 3px var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
