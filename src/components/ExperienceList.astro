---
/**
 * ExperienceList.astro — Layered Document stack of experience entries.
 *
 * Layout: All cards share a single grid cell (grid-template-areas: "stack"),
 *         offset diagonally via CSS transforms — the featured role at the top,
 *         past roles cascaded behind it. Hover/focus lifts any card to the front.
 *
 * On mobile (≤768px) and reduced-motion: transforms are reset, cards stack
 * vertically in normal flow.
 *
 * Props:
 *   entries — CollectionEntry<'experience'>[]
 *   locale  — 'es' | 'en'
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import ExperienceCard from './ExperienceCard.astro';
import SectionBackdrop from './SectionBackdrop.astro';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;

// Sort: featured first, then reverse-chronological.
const sorted = [...entries].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  const endA = a.data.current ? Number.POSITIVE_INFINITY : (a.data.endYear ?? a.data.startYear);
  const endB = b.data.current ? Number.POSITIVE_INFINITY : (b.data.endYear ?? b.data.startYear);

  if (endA !== endB) return endB - endA;

  if (a.data.startYear !== b.data.startYear) {
    return b.data.startYear - a.data.startYear;
  }

  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

/**
 * Build the year label for the card.
 * Single year: "2021"
 * Multi-year: "2022–2023"
 * Current: "2023–pres"
 */
function yearLabel(entry: CollectionEntry<'experience'>, locale: Locale): string {
  const { startYear, endYear, current } = entry.data;
  if (current) {
    const presText = t(locale, 'experience.present').slice(0, 4).toLowerCase();
    return `${startYear}–${presText}`;
  }
  if (endYear && endYear !== startYear) {
    return `${startYear}–${endYear}`;
  }
  return String(startYear);
}
---

<section id="experience" class="experience-section" aria-labelledby="experience-heading">
  <SectionBackdrop variant="experience" />
  <div class="experience-inner">
    <h2 id="experience-heading">{t(locale, 'experience.title')}</h2>
    <p class="experience-intro">{t(locale, 'experience.intro')}</p>

    <ol class="xp-stack" aria-label="Career timeline">
      {sorted.map((entry, index) => {
        const isFeatured = Boolean(entry.data.featured);
        const label = yearLabel(entry, locale);
        return (
          <li class="xp-card-wrap" data-index={index}>
            <ExperienceCard
              entry={entry}
              locale={locale}
              index={index}
              isFeatured={isFeatured}
              yearLabel={label}
            />
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  /* ── Section shell ───────────────────────────────────────────────────────── */

  .experience-section {
    padding: var(--space-16) var(--space-4);
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--brand) 10%, transparent) 0%, transparent 34%),
      radial-gradient(circle at bottom right, color-mix(in srgb, var(--accent) 8%, transparent) 0%, transparent 38%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 82%, var(--surface)) 0%, color-mix(in srgb, var(--bg) 92%, var(--surface)) 100%);
    position: relative;
    overflow: hidden;
  }

  /* Atmospheric corner glows */
  .experience-section::before,
  .experience-section::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  .experience-section::before {
    top: -120px;
    right: -140px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand) 12%, transparent) 0%, transparent 72%);
    filter: blur(18px);
  }

  .experience-section::after {
    bottom: -160px;
    left: -180px;
    width: 560px;
    height: 260px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 70%);
    transform: rotate(-8deg);
    filter: blur(12px);
  }

  /* ── Inner container ─────────────────────────────────────────────────────── */

  .experience-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
    z-index: 1;
  }

  .experience-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
  }

  .experience-intro {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* ── Layered Document stack ──────────────────────────────────────────────── */

  .xp-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    /* All cards share one grid cell — stacking context */
    display: grid;
    grid-template-areas: "stack";
    /* Enough height so the diagonal cascade has room without overflow */
    min-height: clamp(400px, 50vh, 520px);
    /* Right padding makes room for the peeking edges of cards behind */
    padding-inline-end: clamp(80px, 12vw, 140px);
    padding-block-end: clamp(60px, 8vh, 100px);
    position: relative;
  }

  .xp-card-wrap {
    grid-area: stack;
  }

  /* ── Mobile: flatten to vertical stack ──────────────────────────────────── */

  @media (max-width: 768px) {
    .xp-stack {
      grid-template-areas: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: auto;
      padding-inline-end: 0;
      padding-block-end: 0;
    }

    .xp-card-wrap {
      grid-area: auto;
    }
  }
</style>
