---
/**
 * ExperienceList.astro — Faceted Stack editorial bands.
 *
 * Layout: Each role is a full-width band (xp-band) with a two-column grid:
 *   LEFT  — large mono year anchor
 *   RIGHT — content (role, company, location, summary, highlights, stack)
 *
 * Desktop (≥769px): two-column grid with clamp year column.
 * Mobile  (≤768px): single-column flow, year stacks above content.
 *
 * Bands are separated by a diagonal hairline divider (::after pseudo-element
 * on each <li>, skewed -2° to echo the logo's V/N letter cuts).
 * Featured band (Fletes) gets a 2px brand top edge + inline facet cluster SVG.
 *
 * Props:
 *   entries — CollectionEntry<'experience'>[]
 *   locale  — 'es' | 'en'
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import ExperienceCard from './ExperienceCard.astro';
import SectionBackdrop from './SectionBackdrop.astro';

interface Props {
  entries: CollectionEntry<'experience'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;

// Sort: featured first, then reverse-chronological.
const sorted = [...entries].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  const endA = a.data.current ? Number.POSITIVE_INFINITY : (a.data.endYear ?? a.data.startYear);
  const endB = b.data.current ? Number.POSITIVE_INFINITY : (b.data.endYear ?? b.data.startYear);

  if (endA !== endB) return endB - endA;

  if (a.data.startYear !== b.data.startYear) {
    return b.data.startYear - a.data.startYear;
  }

  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

/**
 * Build the year label for the band.
 * Single year: "2021"
 * Multi-year: "2022–2023"
 * Current: "2023–pres"
 */
function yearLabel(entry: CollectionEntry<'experience'>, locale: Locale): string {
  const { startYear, endYear, current } = entry.data;
  if (current) {
    const presText = t(locale, 'experience.present').slice(0, 4).toLowerCase();
    return `${startYear}–${presText}`;
  }
  if (endYear && endYear !== startYear) {
    return `${startYear}–${endYear}`;
  }
  return String(startYear);
}
---

<section id="experience" class="experience-section" aria-labelledby="experience-heading">
  <SectionBackdrop variant="experience" />
  <div class="experience-inner">
    <h2 id="experience-heading">{t(locale, 'experience.title')}</h2>
    <p class="experience-intro">{t(locale, 'experience.intro')}</p>

    <ol class="xp-bands" aria-label="Career timeline">
      {sorted.map((entry, index) => {
        const isFeatured = Boolean(entry.data.featured);
        const label = yearLabel(entry, locale);
        return (
          <li class:list={['xp-band', { 'xp-band--featured': isFeatured }]}>
            <ExperienceCard
              entry={entry}
              locale={locale}
              index={index}
              isFeatured={isFeatured}
              yearLabel={label}
            />
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  /* ── Section shell ───────────────────────────────────────────────────────── */

  .experience-section {
    padding: var(--space-16) var(--space-4);
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--brand) 10%, transparent) 0%, transparent 34%),
      radial-gradient(circle at bottom right, color-mix(in srgb, var(--accent) 8%, transparent) 0%, transparent 38%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 82%, var(--surface)) 0%, color-mix(in srgb, var(--bg) 92%, var(--surface)) 100%);
    position: relative;
    overflow: hidden;
  }

  /* Atmospheric corner glows */
  .experience-section::before,
  .experience-section::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  .experience-section::before {
    top: -120px;
    right: -140px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand) 12%, transparent) 0%, transparent 72%);
    filter: blur(18px);
  }

  .experience-section::after {
    bottom: -160px;
    left: -180px;
    width: 560px;
    height: 260px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 70%);
    transform: rotate(-8deg);
    filter: blur(12px);
  }

  /* ── Inner container ─────────────────────────────────────────────────────── */

  .experience-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
    z-index: 1;
  }

  .experience-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
  }

  .experience-intro {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* ── Faceted Stack bands list ────────────────────────────────────────────── */

  .xp-bands {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* ── Individual band ─────────────────────────────────────────────────────── */

  .xp-band {
    position: relative;
    padding-block: clamp(2rem, 5vh, 3rem);
  }

  /* Diagonal hairline divider — skewed -2° to echo logo V/N cuts */
  .xp-band::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(115, 160, 190, 0.18) 20%,
      rgba(115, 160, 190, 0.18) 80%,
      transparent
    );
    transform: skewX(-2deg);
    pointer-events: none;
  }

  /* No divider after the final band */
  .xp-band:last-child::after {
    display: none;
  }

  /* Featured: brand top edge instead of divider */
  .xp-band--featured {
    border-top: 2px solid var(--brand);
  }

  /* ── Scroll-driven rise animation ───────────────────────────────────────── */

  @supports (animation-timeline: view()) {
    .xp-band {
      animation: xp-band-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }
  }

  @keyframes xp-band-rise {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Reduced-motion: skip entrance animation entirely */
  @media (prefers-reduced-motion: reduce) {
    .xp-band {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  /* ── Mobile: single-column flow ──────────────────────────────────────────── */

  @media (max-width: 768px) {
    .xp-band {
      padding-block: clamp(1.5rem, 4vh, 2rem);
    }
  }
</style>
