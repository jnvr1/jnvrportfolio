---
/**
 * Footer.astro — Site footer with social links and copyright.
 *
 * Props:
 *   locale — 'es' | 'en'
 */
import type { Locale } from "../i18n/index";
import { t } from "../i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-social">
      <a
        href="https://github.com/jnvr1"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="social-link"
      >
        <img src="/icons/github.svg" alt="GitHub" width="20" height="20" />
      </a>
      <a
        href="https://linkedin.com/in/jnvr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="social-link"
      >
        <img src="/icons/linkedin.svg" alt="LinkedIn" width="20" height="20" />
      </a>
    </div>

    <p class="footer-copy">
      &copy; {year} Jonathan Noé Viramontes &mdash; {t(locale, "footer.rights")}
    </p>

    <p class="footer-archive">
      <span class="footer-archive__label"
        >{t(locale, "footer.archiveLabel")}:</span
      >

      <span class="footer-archive__sep" aria-hidden="true">·</span>
      <a
        href="https://jnvr-portafolio-v1.web.app/home"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-archive__link"
      >
        v1 <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-8) var(--space-4);
    margin-top: var(--space-16);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .social-link {
    color: var(--muted);
    transition:
      color 150ms,
      opacity 150ms;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-md);
    opacity: 0.6;
  }

  .social-link:hover {
    opacity: 1;
  }

  .social-link img {
    filter: brightness(0) invert(1);
    opacity: inherit;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }

  .footer-archive {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .footer-archive__label {
    color: var(--muted);
    opacity: 0.75;
  }

  .footer-archive__link {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--brand) 40%, transparent);
    padding-bottom: 1px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .footer-archive__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .footer-archive__sep {
    color: var(--border);
    user-select: none;
  }

  @media (max-width: 480px) {
    .site-footer {
      padding-inline: var(--space-4);
      padding-block: var(--space-6);
    }

    .footer-inner {
      gap: var(--space-2);
    }
  }
</style>
