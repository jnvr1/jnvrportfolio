---
/**
 * Logo.astro — JNVR brand mark (square faceted icon, no wordmark).
 *
 * Uses a plain <img> tag for maximum compatibility. Per-path animations
 * via inlined SVG were attempted but the inline approach failed to render
 * reliably across Astro dev server / readFileSync / ?raw paths. Wrapper-level
 * animations (entrance, breathing, halo) still work via .hero-logo-wrap.
 *
 * Props:
 *   size      — CSS width value (default: 560px). Height scales automatically.
 *   ariaLabel — Accessible label (default: 'JNVR')
 */
interface Props {
  size?: number;
  ariaLabel?: string;
}

const { size = 560, ariaLabel = 'JNVR' } = Astro.props;
---

<span
  class="logo-wrapper"
  style={`--logo-size: ${size}px`}
>
  <img
    src="/logo-mark.svg"
    alt={ariaLabel}
    width={size}
    height={size}
    decoding="async"
    fetchpriority="high"
  />
</span>

<style>
  .logo-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .logo-wrapper > img {
    width: var(--logo-size, 560px);
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .logo-wrapper > img {
      width: 360px;
    }
  }

  @media (max-width: 480px) {
    .logo-wrapper > img {
      width: 280px;
    }
  }
</style>
