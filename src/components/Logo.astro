---
/**
 * Logo.astro — JNVR brand mark (square faceted icon, no wordmark).
 *
 * Inlined SVG (via Vite's ?raw import) so the inner <path> elements are
 * targetable by global CSS for the blueprint draw-in entrance animation.
 * Vite watches the file and hot-reloads the dev server when it changes.
 *
 * Props:
 *   size      — CSS width value (default: 560px). Height scales automatically
 *               via the SVG's natural viewBox (0 0 1600 1600).
 *   ariaLabel — Accessible label (default: 'JNVR')
 */
import logoSvg from '../assets/logo-mark.svg?raw';

interface Props {
  size?: number;
  ariaLabel?: string;
}

const { size = 560, ariaLabel = 'JNVR' } = Astro.props;
---

<span
  class="logo-wrapper"
  role="img"
  aria-label={ariaLabel}
  style={`--logo-size: ${size}px`}
  set:html={logoSvg}
/>

<style>
  .logo-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Target the inlined SVG directly */
  .logo-wrapper > svg {
    width: var(--logo-size, 480px);
    height: auto;
    display: block;
  }

  /* Mobile: scale down to 300px */
  @media (max-width: 768px) {
    .logo-wrapper > svg {
      width: 300px;
    }
  }

  /* Small mobile */
  @media (max-width: 480px) {
    .logo-wrapper > svg {
      width: 260px;
    }
  }
</style>
