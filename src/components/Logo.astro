---
/**
 * Logo.astro — JNVR brand mark (square faceted icon, no wordmark).
 *
 * Switched from logo-jnvr.svg (wordmark with split text) to logo-mark.svg
 * (clean 1600×1600 faceted brand icon). The component renders it via <img>
 * so the wrapper element in Hero.astro can own all entrance / breathing
 * animations without conflicting with inline SVG animation concerns.
 *
 * Props:
 *   size      — Width/height in px (default: 320). Square aspect ratio.
 *   ariaLabel — Accessible label (default: 'JNVR')
 */
interface Props {
  size?: number;
  ariaLabel?: string;
}

const { size = 320, ariaLabel = 'JNVR' } = Astro.props;
---

<span class="logo-wrapper" role="img" aria-label={ariaLabel}>
  <img
    src="/logo-mark.svg"
    alt={ariaLabel}
    width={size}
    height={size}
    class="logo-img"
    loading="eager"
    decoding="async"
  />
</span>

<style>
  .logo-wrapper {
    display: inline-flex;
    align-items: center;
  }

  .logo-img {
    width: var(--logo-size, 320px);
    height: var(--logo-size, 320px);
  }

  /* Mobile: scale down to 220px */
  @media (max-width: 768px) {
    .logo-img {
      width: 220px;
      height: 220px;
    }
  }
</style>
