---
/**
 * ThemeStyles.astro — Injects dark-only theme meta tag.
 *
 * Used inside BaseLayout <head>. For v1, dark theme is the only theme.
 * No JS required — just a meta tag and CSS custom properties via tokens.css.
 */
---

<meta name="color-scheme" content="dark" />
<!-- Must stay in sync with --bg in tokens.css (a meta tag can't reference a CSS var). -->
<meta name="theme-color" content="#0A1929" />
