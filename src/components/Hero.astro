---
/**
 * Hero.astro — Above-the-fold section.
 *
 * Renders: name, role, FletesBadge, JNVR Logo, and two CTAs.
 * Text from i18n strings. Logo animation is CSS-only, no JS.
 *
 * Props:
 *   locale — 'es' | 'en'
 */
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import Logo from './Logo.astro';
import FletesBadge from './FletesBadge.astro';
import HeroBackdrop from './HeroBackdrop.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = locale === 'es' ? '' : '/en';
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <HeroBackdrop />
  <div class="hero-inner">
    <div class="hero-logo-wrap">
      <Logo size={560} ariaLabel="JNVR" />
    </div>

    <div class="hero-content">
      <FletesBadge locale={locale} />

      <h1 id="hero-heading" class="hero-name">
        Jonathan Noé Viramontes
        <span class="hero-role">{t(locale, 'hero.role')}</span>
      </h1>

      <p class="hero-tagline">{t(locale, 'hero.tagline')}</p>

      <div class="hero-ctas">
        <a href={`${base}/#projects`} class="btn btn-primary">
          {t(locale, 'cta.projects')}
        </a>
        <a href={`${base}/#contact`} class="btn btn-secondary">
          {t(locale, 'cta.contact')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: var(--space-16) var(--space-4) var(--space-12);
    /* Position context for HeroBackdrop (absolute, inset: 0).
       Overflow hidden keeps the facet polygons clipped to the hero bounds.
       The global SVG facets + orbs on body remain visible through the
       transparent hero background; HeroBackdrop adds a denser local layer. */
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    /* Elevate above HeroBackdrop (z-index: 0) */
    position: relative;
    z-index: 1;
  }

  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    position: relative;
    /*
     * Chained animations:
     *   1. logo-entrance (0s → 1.4s): reveal from dispersed state + glow burst
     *   2. logo-breathing (8s loop, starts at 1.4s): settles into ambient glow
     * `both` fill-mode keeps the entrance end-state applied before breathing starts.
     */
    animation:
      logo-entrance 1.4s cubic-bezier(0.16, 1, 0.3, 1) both,
      logo-breathing 8s ease-in-out infinite 1.4s;
    will-change: transform, filter, opacity;
  }

  @keyframes logo-entrance {
    0% {
      opacity: 0;
      transform: scale(0.85) rotate(-3deg);
      filter: drop-shadow(0 0 16px rgba(115, 160, 190, 0.3)) blur(12px);
    }
    60% {
      opacity: 1;
      filter: drop-shadow(0 0 60px rgba(115, 160, 190, 0.36)) blur(0px);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
      filter: drop-shadow(0 0 32px rgba(115, 160, 190, 0.22)) blur(0px);
    }
  }

  @keyframes logo-breathing {
    0%, 100% { filter: drop-shadow(0 0 24px rgba(115, 160, 190, 0.18)); }
    50%       { filter: drop-shadow(0 0 40px rgba(115, 160, 190, 0.28)); }
  }

  /* Radial halo burst — expands from center at peak glow (~0.7s) then fades */
  .hero-logo-wrap::before {
    content: '';
    position: absolute;
    inset: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(115, 160, 190, 0.18), transparent 60%);
    animation: logo-halo 1.4s ease-out both;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes logo-halo {
    0%   { width: 0;     height: 0;     opacity: 0; transform: translate(-50%, -50%); }
    40%  { opacity: 1; }
    100% { width: 600px; height: 600px; opacity: 0; transform: translate(-50%, -50%); }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    max-width: 720px;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: 1.05;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .hero-role {
    display: block;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    margin-top: var(--space-2);
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-12);
      min-height: auto;
    }
    /* Logo mobile sizing is handled in Logo.astro (300px at ≤768px, 260px at ≤480px) */
  }
</style>
