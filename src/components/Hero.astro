---
/**
 * Hero.astro — Above-the-fold section.
 *
 * Renders: name, role, FletesBadge, JNVR Logo, and two CTAs.
 * Text from i18n strings. Logo motion is CSS-only, no JS.
 *
 * Props:
 *   locale — 'es' | 'en'
 */
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import Logo from './Logo.astro';
import FletesBadge from './FletesBadge.astro';
import HeroBackdrop from './HeroBackdrop.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = locale === 'es' ? '' : '/en';
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <HeroBackdrop />
  <div class="hero-inner">
    <div class="hero-logo-wrap">
      <Logo size={560} ariaLabel="JNVR" animated />
    </div>

    <div class="hero-content">
      <FletesBadge locale={locale} />

      <h1 id="hero-heading" class="hero-name">
        Jonathan Noé Viramontes
        <span class="hero-role">{t(locale, 'hero.role')}</span>
      </h1>

      <p class="hero-tagline">{t(locale, 'hero.tagline')}</p>

      <div class="hero-ctas">
        <a href={`${base}/#projects`} class="btn btn-primary">
          {t(locale, 'cta.projects')}
        </a>
        <a href={`${base}/#contact`} class="btn btn-secondary">
          {t(locale, 'cta.contact')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 74vh;
    display: flex;
    align-items: center;
    padding: var(--space-12) var(--space-4) var(--space-8);
    /* Position context for HeroBackdrop (absolute, inset: 0).
       Overflow hidden keeps the facet polygons clipped to the hero bounds.
       The global SVG facets + orbs on body remain visible through the
       transparent hero background; HeroBackdrop adds a denser local layer. */
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    /* Elevate above HeroBackdrop (z-index: 0) */
    position: relative;
    z-index: 1;
  }

  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 720px;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: 1.05;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .hero-role {
    display: block;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    margin-top: var(--space-2);
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-10);
      min-height: auto;
    }
    /* Logo mobile sizing is handled in Logo.astro (300px at ≤768px, 260px at ≤480px) */
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--space-8) var(--space-4) var(--space-6);
    }

    .hero-logo-wrap {
      max-width: 260px;
    }

    .hero-content {
      gap: var(--space-3);
    }

    .hero-ctas {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero-ctas .btn {
      width: 100%;
    }
  }
</style>
