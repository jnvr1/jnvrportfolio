---
/**
 * ProjectGrid.astro — Grid container rendering all ProjectCards.
 *
 * Includes a filter chip strip (Flutter | React | PHP | Astro).
 * Filter logic runs inline here so the grid can animate reflow in sync with the
 * visible card set.
 *
 * Props:
 *   projects — CollectionEntry<'projects'>[]
 *   locale   — 'es' | 'en'
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import ProjectCard from './ProjectCard.astro';
import ScrollReveal from './ScrollReveal.astro';
import SectionBackdrop from './SectionBackdrop.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  locale: Locale;
}

const { projects, locale } = Astro.props;

// The 4 main filter chips per design spec
const FILTER_CHIPS = ['Flutter', 'React', 'PHP', 'Astro'] as const;
---

<section
  id="projects"
  class="projects-section"
  aria-labelledby="projects-heading"
  data-locale={locale}
  data-active-filter="all"
>
  <SectionBackdrop variant="projects" />
  <div class="projects-inner">
    <ScrollReveal>
      <h2 id="projects-heading">{t(locale, 'projects.title')}</h2>
    </ScrollReveal>

    <ScrollReveal delay={80}>
      <p class="projects-intro">{t(locale, 'projects.intro')}</p>
    </ScrollReveal>

    <!-- Filter chips -->
    <div
      class="filter-group"
      role="group"
      aria-label={t(locale, 'projects.filterLabel')}
      id="project-filter-group"
    >
      <button
        type="button"
        class="filter-chip filter-chip--all filter-chip--active"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {FILTER_CHIPS.map((tech) => (
        <button
          type="button"
          class="filter-chip"
          data-filter={tech}
          aria-pressed="false"
        >
          {tech}
        </button>
      ))}
    </div>

    <!-- Live region for filter count -->
    <p class="filter-count" role="status" aria-live="polite" id="filter-count">
      {projects.length} {locale === 'es' ? 'proyectos' : 'projects'}
    </p>

    <!-- Grid -->
    <div
      class="projects-grid"
      id="projects-grid"
      aria-label={t(locale, 'projects.title')}
    >
      {projects.map((entry, i) => (
        <ScrollReveal delay={i * 60} class="project-grid-item" data-stack={entry.data.stack.join(' ')}>
          <ProjectCard entry={entry} locale={locale} />
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: var(--space-16) var(--space-4);
    /* Position context for SectionBackdrop (position: absolute, inset: 0) */
    position: relative;
    overflow: hidden;
  }

  .projects-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /* Elevate above SectionBackdrop */
    position: relative;
    z-index: 1;
  }

  .projects-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
  }

  .projects-intro {
    max-width: 56ch;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: var(--space-1) var(--space-3);
    min-height: 44px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 150ms, border-color 150ms, color 150ms;
    touch-action: manipulation;
  }

  .filter-chip:hover,
  .filter-chip--active,
  .filter-chip[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
  }

  .filter-count {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }

  .projects-grid > .project-grid-item {
    display: block;
    will-change: transform, opacity;
    transform-origin: top left;
  }

  .projects-grid > .project-grid-item[hidden] {
    display: none !important;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 480px) {
    .projects-section {
      padding: var(--space-12) var(--space-4);
    }

    .filter-group {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: calc(var(--space-4) * -1);
      padding-inline: var(--space-4);
      padding-bottom: var(--space-1);
      /* Hint at horizontal scrollability with a fade on the right edge */
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 32px), transparent 100%);
      mask-image: linear-gradient(to right, black calc(100% - 32px), transparent 100%);
    }

    .filter-group::-webkit-scrollbar {
      display: none;
    }

    .filter-chip {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

<script>
  // Project filter client-side logic
  const group = document.getElementById('project-filter-group');
  const grid = document.getElementById('projects-grid');
  const countEl = document.getElementById('filter-count');
  const section = document.getElementById('projects');
  const locale = (section?.getAttribute('data-locale') ?? 'es') as 'es' | 'en';
  const prefersReducedMotion =
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ENTER_DURATION = 180;
  const MOVE_DURATION = 240;
  const ENTER_EASING = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const MOVE_EASING = 'cubic-bezier(0.2, 0, 0, 1)';

  if (group && grid) {
    const chips = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.project-grid-item'));

    function matchesFilter(item: HTMLElement, filter: string) {
      if (filter === 'all') return true;
      const stack = item.getAttribute('data-stack') ?? '';
      return stack.split(' ').includes(filter);
    }

    function resetInlineMotion(item: HTMLElement) {
      item.style.removeProperty('opacity');
      item.style.removeProperty('transform');
    }

    function cancelAnimations(item: HTMLElement) {
      item.getAnimations().forEach((animation) => animation.cancel());
      resetInlineMotion(item);
    }

    function filterProjects(filter: string) {
      if (section) section.setAttribute('data-active-filter', filter);

      const firstRects = new Map<HTMLElement, DOMRect>();
      const visibleBefore = items.filter((item) => !item.hidden);
      visibleBefore.forEach((item) => {
        firstRects.set(item, item.getBoundingClientRect());
      });

      const visibleAfter = items.filter((item) => matchesFilter(item, filter));
      const visibleAfterSet = new Set(visibleAfter);

      items.forEach((item) => {
        const shouldShow = visibleAfterSet.has(item);
        if (!shouldShow) {
          cancelAnimations(item);
          item.hidden = true;
          return;
        }

        cancelAnimations(item);
        item.hidden = false;

        if (!firstRects.has(item)) {
          item.style.opacity = '0';
          item.style.transform = 'translateY(14px) scale(0.98)';
        }
      });

      const visible = visibleAfter.length;

      if (countEl) {
        countEl.textContent = `${visible} ${locale === 'es' ? 'proyectos' : 'projects'}`;
      }

      if (prefersReducedMotion) {
        return;
      }

      // Wait one frame so the grid can recalculate after hidden items collapse.
      requestAnimationFrame(() => {
        const lastRects = new Map<HTMLElement, DOMRect>();
        visibleAfter.forEach((item) => {
          lastRects.set(item, item.getBoundingClientRect());
        });

        visibleAfter.forEach((item) => {
          const first = firstRects.get(item);
          const last = lastRects.get(item);

          if (!first || !last) {
            const animation = item.animate(
              [
                { opacity: 0, transform: 'translateY(14px) scale(0.98)' },
                { opacity: 1, transform: 'translateY(0) scale(1)' },
              ],
              {
                duration: ENTER_DURATION,
                easing: ENTER_EASING,
                fill: 'both',
              },
            );
            animation.addEventListener('finish', () => {
              resetInlineMotion(item);
            });
            return;
          }

          const dx = first.left - last.left;
          const dy = first.top - last.top;

          if (!dx && !dy) {
            resetInlineMotion(item);
            return;
          }

          item.style.transform = `translate(${dx}px, ${dy}px)`;

          const animation = item.animate(
            [
              { transform: `translate(${dx}px, ${dy}px)`, opacity: 1 },
              { transform: 'translate(0, 0)', opacity: 1 },
            ],
            {
              duration: MOVE_DURATION,
              easing: MOVE_EASING,
              fill: 'both',
            },
          );
          animation.addEventListener('finish', () => {
            resetInlineMotion(item);
          });
        });
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        // Update aria-pressed on all chips
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');

        const filter = chip.getAttribute('data-filter') ?? 'all';
        filterProjects(filter);
      });
    });

    filterProjects('all');
  }
</script>
