---
/**
 * ProjectGrid.astro — Grid container rendering all ProjectCards.
 *
 * Includes a filter chip strip (Flutter | React | PHP | Astro).
 * Filter logic lives in project-filter.ts (client-side JS, loaded client:visible).
 *
 * Props:
 *   projects — CollectionEntry<'projects'>[]
 *   locale   — 'es' | 'en'
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/index';
import { t } from '../i18n/index';
import ProjectCard from './ProjectCard.astro';
import ScrollReveal from './ScrollReveal.astro';
import SectionBackdrop from './SectionBackdrop.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  locale: Locale;
}

const { projects, locale } = Astro.props;

// The 4 main filter chips per design spec
const FILTER_CHIPS = ['Flutter', 'React', 'PHP', 'Astro'] as const;
---

<section id="projects" class="projects-section" aria-labelledby="projects-heading">
  <SectionBackdrop variant="projects" />
  <div class="projects-inner">
    <ScrollReveal>
      <h2 id="projects-heading">{t(locale, 'projects.title')}</h2>
    </ScrollReveal>

    <!-- Filter chips -->
    <div
      class="filter-group"
      role="group"
      aria-label={t(locale, 'projects.filterLabel')}
      id="project-filter-group"
    >
      <button
        class="filter-chip filter-chip--all filter-chip--active"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {FILTER_CHIPS.map((tech) => (
        <button
          class="filter-chip"
          data-filter={tech}
          aria-pressed="false"
        >
          {tech}
        </button>
      ))}
    </div>

    <!-- Live region for filter count -->
    <p class="filter-count" role="status" aria-live="polite" id="filter-count">
      {projects.length} {locale === 'es' ? 'proyectos' : 'projects'}
    </p>

    <!-- Grid -->
    <div
      class="projects-grid"
      id="projects-grid"
      aria-label={t(locale, 'projects.title')}
    >
      {projects.map((entry, i) => (
        <ScrollReveal delay={i * 60}>
          <ProjectCard entry={entry} locale={locale} />
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: var(--space-16) var(--space-4);
    /* Position context for SectionBackdrop (position: absolute, inset: 0) */
    position: relative;
    overflow: hidden;
  }

  .projects-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /* Elevate above SectionBackdrop */
    position: relative;
    z-index: 1;
  }

  .projects-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: var(--space-1) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }

  .filter-chip:hover,
  .filter-chip--active,
  .filter-chip[aria-pressed='true'] {
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
  }

  .filter-count {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
</style>

<script>
  // Project filter client-side logic
  const group = document.getElementById('project-filter-group');
  const grid = document.getElementById('projects-grid');
  const countEl = document.getElementById('filter-count');

  if (group && grid) {
    const chips = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = grid.querySelectorAll<HTMLElement>('[data-stack]');

    function filterProjects(filter: string) {
      let visible = 0;

      cards.forEach((card) => {
        const stack = card.getAttribute('data-stack') ?? '';
        const matches = filter === 'all' || stack.split(',').includes(filter);
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });

      if (countEl) {
        countEl.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        // Update aria-pressed on all chips
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');

        const filter = chip.getAttribute('data-filter') ?? 'all';
        filterProjects(filter);
      });
    });
  }
</script>
