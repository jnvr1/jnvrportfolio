---
/**
 * ScrollReveal.astro — Facet entrance wrapper for a block.
 *
 * Renders <div data-scroll-reveal>. The motion (a facet snap that echoes the
 * logo's jnvr-facet-enter: rise + subtle scale overshoot + blur-to-sharp) lives
 * in global.css keyed on [data-scroll-reveal]; the IntersectionObserver that
 * adds [data-revealed] is the inline reveal script in BaseLayout. Content is
 * visible by default — a script/CSP/network failure never blanks the page.
 *
 * For elements that need a specific tag (e.g. an <li> inside an <ol>), put
 * data-scroll-reveal (+ a --reveal-delay style) directly on that element instead
 * of wrapping it — see ExperienceCard.astro.
 *
 * Props:
 *   delay — reveal delay in ms (default: 0); staggers grouped siblings
 */
interface Props {
  delay?: number;
  class?: string;
}

const { delay = 0, class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class:list={['scroll-reveal', className]}
  data-scroll-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <slot />
</div>
