---
/**
 * ScrollReveal.astro — Fade + translateY entrance animation via IntersectionObserver.
 *
 * Wraps any child element. The data-scroll-reveal attribute is picked up by
 * scroll-reveal.ts which adds data-revealed once the element enters the viewport.
 *
 * CSS transitions handle the animation; JS only toggles the attribute.
 * prefers-reduced-motion: elements appear in final state immediately (no motion).
 *
 * Props:
 *   delay — Animation delay in ms (default: 0)
 *   once  — Only animate once (default: true)
 */
interface Props {
  delay?: number;
  once?: boolean;
  class?: string;
}

const { delay = 0, class: className } = Astro.props;
---

<div
  class:list={['scroll-reveal', className]}
  data-scroll-reveal
  style={delay ? `--reveal-delay: ${delay}ms` : undefined}
>
  <slot />
</div>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
  }

  .scroll-reveal[data-revealed] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/scroll-reveal.ts';
</script>
