---
/**
 * HeroBackdrop.astro — Local facet cluster for the Hero section.
 *
 * Inline SVG (~5 polygons) that positions itself absolutely behind the
 * Hero content. Echoes the logo's geometric language (logo colors:
 * st0 = #73A0BE, st1 = #0F293F, st3 = #A7A6A8) with denser facet
 * composition than the global backdrop-facets.svg.
 *
 * Stacking: position absolute, inset: 0, z-index: 0.
 * Parent (.hero) must have position: relative; overflow: hidden.
 *
 * No props — this is a fixed, art-directed composition.
 * All SVG elements are aria-hidden (decorative).
 *
 * Spec: Option 4 Full Composition — Hero "Faceted Centerpiece"
 */
---

<div class="hero-backdrop section-backdrop" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1200 700"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
    class="hero-backdrop__svg"
  >
    <!--
      5 facets arranged to frame the center (logo position) without covering it.
      Colors sourced directly from the logo's st0/st1/st3 class fills.
      All at low opacity so the body-level facets + orbs remain visible through.

      Logo color reference:
        st0 = #73A0BE (brand blue — dominant logo shape)
        st1 = #0F293F (deep navy — logo shadow/depth)
        st3 = #A7A6A8 (warm gray — logo dot accent)
        surface-elevated = #1A3A5C
    -->

    <!-- Top-left wing: large diagonal cut echoing the N/J letter diagonal -->
    <g class="facet facet-1">
      <polygon
        points="0,0 420,0 280,180 0,240"
        fill="#0F293F"
        opacity="0.55"
      />
    </g>

    <!-- Top-right wing: mirrors the V letterform wedge from the logo -->
    <g class="facet facet-2">
      <polygon
        points="780,0 1200,0 1200,200 960,120"
        fill="#1A3A5C"
        opacity="0.45"
      />
    </g>

    <!-- Left-center shard: brand-blue highlight at very low opacity -->
    <!-- Echoes the st0 diagonal cut in the N letterform -->
    <g class="facet facet-3">
      <polygon
        points="0,180 200,120 260,300 40,340"
        fill="#73A0BE"
        opacity="0.06"
      />
    </g>

    <!-- Bottom-left anchor: heavy base mass like the J's foot -->
    <g class="facet facet-4">
      <polygon
        points="0,480 360,420 440,600 180,700 0,700"
        fill="#0F293F"
        opacity="0.50"
      />
    </g>

    <!-- Bottom-right anchor: mirrors logo's lower-right shadow stack -->
    <g class="facet facet-5">
      <polygon
        points="760,520 1200,440 1200,700 700,700"
        fill="#1A3A5C"
        opacity="0.40"
      />
    </g>

    <!-- Center subtle warm-gray shimmer: echoes logo's st3 dot (#A7A6A8) -->
    <!-- Very low opacity — just a whisper of warmth behind the logo -->
    <g class="facet facet-6">
      <polygon
        points="480,60 720,40 760,160 500,180"
        fill="#A7A6A8"
        opacity="0.03"
      />
    </g>
  </svg>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-backdrop__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Drifting Facet Animations ──────────────────────────────────────────── */

  .hero-backdrop .facet {
    transform-origin: center;
    will-change: transform;
    animation: hero-facet-drift 18s ease-in-out infinite alternate;
  }

  /* Staggered timing: each facet drifts on its own schedule */
  .hero-backdrop .facet-1 { animation-duration: 22s; animation-delay: -2s; }
  .hero-backdrop .facet-2 { animation-duration: 16s; animation-delay: -7s; }
  .hero-backdrop .facet-3 { animation-duration: 20s; animation-delay: -12s; }
  .hero-backdrop .facet-4 { animation-duration: 14s; animation-delay: -4s; }
  .hero-backdrop .facet-5 { animation-duration: 19s; animation-delay: -9s; }
  .hero-backdrop .facet-6 { animation-duration: 17s; animation-delay: -14s; }

  @keyframes hero-facet-drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(6px, -4px) scale(1.03); }
  }

  /* Mobile: disable facet drift to reduce GPU load on low-end devices */
  @media (max-width: 480px) {
    .hero-backdrop__svg {
      opacity: 0.6;
    }

    .hero-backdrop .facet {
      animation: none;
    }
  }
</style>
